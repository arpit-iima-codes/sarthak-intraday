# Copy to .env and fill in. App credentials come from the Fyers API dashboard
# (https://myapi.fyers.in/dashboard) for the app you registered.

# --- Fyers app credentials ---
FYERS_CLIENT_ID=ABCD1234XY-100
FYERS_SECRET_KEY=xxxxxxxxxx
FYERS_REDIRECT_URI=https://80.225.196.44.nip.io/fyers/callback

# Your Fyers login ID (e.g. XA12345). When set, the login form only asks
# for PIN + TOTP/OTP.
FYERS_FY_ID=

# --- Web server ---
HOST=127.0.0.1
PORT=8092
PUBLIC_URL=https://80.225.196.44.nip.io

# --- Front-door gate (styled login screen shown before the Fyers page) ---
# Leave GATE_PASSWORD empty to disable the gate.
GATE_USER=sarthak
GATE_PASSWORD=

# The buy engine has no .env settings — configure it on the /controls page
# (mode, budget, target/stop %, max positions, square-off, auto-arm). Runtime
# state lives in data/engine_state.json.
